# SMTP Mail Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password-or-token

# Email Addressing
EMAIL_SENDER="Report Bot <your-email@example.com>"
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
EMAIL_CC=
EMAIL_BCC=

# Report Options
REPORT_TITLE=Executive Summary & Regional Performance Report
ENVIRONMENT=production

# Draft Destination for Student Reports (eml or outlook)
DRAFT_TARGET=eml

# ==============================================================================
# Microsoft 365 / Outlook Direct Sync Options (when DRAFT_TARGET=outlook)
# ==============================================================================

# Option A: Windows SSO Token Broker / Microsoft Graph (Default & Recommended)
# NO PASSWORD NEEDED! Uses native Windows Web Account Manager (WAM) & OAuth.
# Syncs drafts directly to New Outlook (olk.exe), Classic Outlook, and Webmail.
M365_SSO=true
# Choose which Microsoft account to use: 'work' (default, organizational M365), 'personal' (Outlook.com/Live), or 'user@domain.com'
M365_ACCOUNT=work
# Optional overrides:
# M365_CLIENT_ID=5d661950-3475-41cd-a2c3-d671a3162bc1
# M365_TENANT_ID=organizations

# Option B: IMAP Server Configuration (Alternative if not using Windows SSO)
# Used if M365_SSO=false or for non-Microsoft IMAP providers (Gmail, Fastmail, etc.)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-app-password-or-token

# Force specific draft sync method: 'auto' (Graph SSO -> COM -> IMAP), 'graph', 'com', or 'imap'
OUTLOOK_METHOD=auto
