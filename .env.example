# SMTP Mail Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password-or-token

# Email Addressing
EMAIL_SENDER="Report Bot <your-email@example.com>"
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
EMAIL_CC=
EMAIL_BCC=

# Report Options
REPORT_TITLE=Executive Summary & Regional Performance Report
ENVIRONMENT=production

# Draft Destination for Student Reports (eml or outlook)
DRAFT_TARGET=eml

# IMAP Server Configuration (Required for syncing drafts directly into New Outlook / Exchange / Gmail)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-app-password-or-token
